<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- El código de producción (src/) solo usa el framework de .NET 8: no tiene paquetes NuGet de terceros.
       nuget.org queda habilitado solo para el proyecto de pruebas unitarias (xUnit). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
