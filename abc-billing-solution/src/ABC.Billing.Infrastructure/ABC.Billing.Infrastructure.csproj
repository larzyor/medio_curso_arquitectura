<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>ABC.Billing.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- System.Security.Cryptography.Xml (XMLDSig) viene dentro del framework compartido de ASP.NET Core: sin paquetes NuGet. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ABC.Billing.Core\ABC.Billing.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- XSD oficiales de OASIS UBL 2.1 (maindoc + common): se copian junto al ensamblado para validar el XML. -->
    <None Include="UblEngine\Schemas\**\*.xsd" CopyToOutputDirectory="PreserveNewest" Link="Schemas\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
